{
  config,
  lib,
  ...
}:
{
  imports = [
    ../../nixos/hardware/disable-watchdog.nix
    ../../nixos/hardware/ecc-ram.nix
    ../../nixos/hardware/nvidia/only.nix
    ../../nixos/hardware/lvm.nix
    ../../nixos/hardware/smart.nix
    ../../nixos/hardware/ups.nix
  ];

  lantian.hostType = lib.mkForce "physical";

  boot.loader.grub = {
    efiSupport = true;
    device = "nodev";
  };

  networking.usePredictableInterfaceNames = lib.mkForce true;

  hardware.nvidia.package = lib.mkForce config.boot.kernelPackages.nvidiaPackages.latest;

  boot.initrd.availableKernelModules = [
    "xhci_pci"
    "ahci"
    "nvme"
    "usb_storage"
    "usbhid"
    "sd_mod"
  ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-amd" ];
  boot.extraModulePackages = [ ];

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/815E-3292";
    fsType = "vfat";
    options = [
      "fmask=0077"
      "dmask=0077"
    ];
  };

  fileSystems."/nix" = {
    device = "/dev/disk/by-uuid/e2c5bd1d-8aa8-44ae-9c2a-b8976a446b4f";
    fsType = "btrfs";
    options = [
      "compress-force=zstd"
      "autodefrag"
      "nosuid"
      "nodev"
    ];
  };

  fileSystems."/mnt/storage" = {
    device = "/dev/MyVolGroup/storage1";
    fsType = "btrfs";
    options = [
      "compress-force=zstd"
      "autodefrag"
      "nosuid"
      "nodev"
      "x-systemd.mount-timeout=infinity"
    ];
  };

  fileSystems."/mnt/hmsmr" = {
    device = "/dev/disk/by-id/ata-ST25000NM000E-3L9103_ZX28SA2W";
    fsType = "xfs";
    options = [
      "nosuid"
      "nodev"
      "x-systemd.mount-timeout=infinity"
    ];
  };

  services.btrfs.autoScrub = {
    enable = true;
    fileSystems = [
      "/mnt/storage"
      "/nix"
    ];
  };

  swapDevices = [
    {
      device = "/dev/MyVolGroup/swap1";
      randomEncryption.enable = true;
    }
    {
      device = "/dev/MyVolGroup/swap2";
      randomEncryption.enable = true;
    }
  ];

  hardware.cpu.amd.updateMicrocode = true;
  hardware.enableRedistributableFirmware = true;
}
