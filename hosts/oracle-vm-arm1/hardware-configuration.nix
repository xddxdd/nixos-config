# to /etc/nixos/configuration.nix instead.
_: {
  imports = [
    ../../nixos/hardware/qemu.nix
  ];

  boot.loader.grub = {
    efiSupport = true;
    device = "nodev";
  };

  fileSystems."/nix" = {
    device = "/dev/disk/by-uuid/7973b63c-7ce4-45ad-a70e-abeb18f3d8da";
    fsType = "btrfs";
    options = [
      "compress-force=zstd"
      "autodefrag"
      "nosuid"
      "nodev"
    ];
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/12CE-A600";
    fsType = "vfat";
    options = [
      "fmask=0077"
      "dmask=0077"
      "nosuid"
      "nodev"
      "noexec"
    ];
  };
}
