diff --git a/pkgs/os-specific/linux/nvidia-x11/builder.sh b/pkgs/os-specific/linux/nvidia-x11/builder.sh
--- a/pkgs/os-specific/linux/nvidia-x11/builder.sh
+++ b/pkgs/os-specific/linux/nvidia-x11/builder.sh
@@ -200,7 +200,9 @@
                 install -Dm755 $i $bin/bin/$i
                 # unmodified binary backup for mounting in containers
                 install -Dm755 $i $bin/origBin/$i
-                patchelf --interpreter "$(cat $NIX_CC/nix-support/dynamic-linker)" \
+                # Keep relocated .dynamic below the original read-only LOAD pages.
+                # patchelf 0.19.2 otherwise makes nvidia-smi's DT_DEBUG unwritable.
+                patchelf --page-size 65536 --interpreter "$(cat $NIX_CC/nix-support/dynamic-linker)" \
                     --set-rpath $out/lib:$libPath $bin/bin/$i
             fi
         done
