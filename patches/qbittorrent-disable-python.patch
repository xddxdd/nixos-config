diff --git a/src/base/search/searchhandler.cpp b/src/base/search/searchhandler.cpp
--- a/src/base/search/searchhandler.cpp
+++ b/src/base/search/searchhandler.cpp
@@ -130,8 +130,16 @@
 
     // Launch search
     // deferred start allows clients to handle starting-related signals
-    QMetaObject::invokeMethod(this, [this]() { m_searchProcess->start(QIODevice::ReadOnly); }
-        , Qt::QueuedConnection);
+    QMetaObject::invokeMethod(this, [this]()
+    {
+        if (Utils::ForeignApps::pythonInfo().executablePath.isEmpty())
+        {
+            emit searchFailed(tr("Python is not available, search engine is disabled."));
+            return;
+        }
+
+        m_searchProcess->start(QIODevice::ReadOnly);
+    }, Qt::QueuedConnection);
 }
 
