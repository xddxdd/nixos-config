+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::time::Duration;
+    use tokio::task::spawn_blocking;
+    use tokio::time::{sleep, timeout};
+
+    #[tokio::test]
+    async fn test_large_write_preserves_bytes() {
+        let (mut stream, mut sender) = AsyncWriteAdapter::new();
+        let data: Vec<u8> = (0usize..2 * 1024 * 1024 + 17)
+            .map(|i| (i ^ (i >> 16)) as u8)
+            .collect();
+        let expected = data.clone();
+        let producer = spawn_blocking(move || {
+            sender.send(&[]).unwrap();
+            sender.send(&data).unwrap();
+            sender.eof().unwrap();
+        });
+
+        let mut actual = Vec::new();
+        let mut largest_chunk = 0;
+        while let Some(chunk) = stream.next().await {
+            let chunk = chunk.unwrap();
+            largest_chunk = largest_chunk.max(chunk.len());
+            actual.extend_from_slice(&chunk);
+        }
+        producer.await.unwrap();
+
+        assert_eq!(actual, expected);
+        assert!(stream.eof);
+        assert!(largest_chunk <= 64 * 1024, "chunk size: {largest_chunk}");
+    }
+
+    #[tokio::test]
+    async fn test_slow_consumer_backpressures_producer() {
+        let (mut stream, mut sender) = AsyncWriteAdapter::new();
+        let (started, ready) = tokio::sync::oneshot::channel();
+        let producer = spawn_blocking(move || {
+            for _ in 0..16 {
+                sender.send(&[42; 64 * 1024]).unwrap();
+            }
+            started.send(()).unwrap();
+            for _ in 16..256 {
+                sender.send(&[42; 64 * 1024]).unwrap();
+            }
+            sender.eof().unwrap();
+        });
+
+        ready.await.unwrap();
+        sleep(Duration::from_millis(100)).await;
+        let blocked = !producer.is_finished();
+        let queued = stream.receiver.len();
+        let mut size = 0;
+        while let Some(chunk) = stream.next().await {
+            let chunk = chunk.unwrap();
+            assert!(chunk.iter().all(|&b| b == 42));
+            size += chunk.len();
+        }
+        producer.await.unwrap();
+
+        assert_eq!(size, 16 * 1024 * 1024);
+        assert_eq!(queued, 16);
+        assert!(
+            blocked,
+            "producer buffered the entire NAR without a consumer"
+        );
+    }
+
+    #[tokio::test]
+    async fn test_dropped_consumer_unblocks_data_sender() {
+        let (stream, mut sender) = AsyncWriteAdapter::new();
+        let (started, ready) = tokio::sync::oneshot::channel();
+        let producer = spawn_blocking(move || {
+            for _ in 0..16 {
+                sender.send(&[42]).unwrap();
+            }
+            started.send(()).unwrap();
+            sender.send(&vec![42; 2 * 1024 * 1024])
+        });
+
+        ready.await.unwrap();
+        sleep(Duration::from_millis(100)).await;
+        let blocked = !producer.is_finished();
+        let queued = stream.receiver.len();
+        drop(stream);
+        let result = timeout(Duration::from_secs(2), producer)
+            .await
+            .unwrap()
+            .unwrap();
+
+        assert_eq!(queued, 16);
+        assert!(blocked, "large write did not block");
+        assert!(result.is_err());
+    }
+
+    #[tokio::test]
+    async fn test_dropped_consumer_unblocks_terminal_sender() {
+        for error in [false, true] {
+            let (stream, mut sender) = AsyncWriteAdapter::new();
+            let (started, ready) = tokio::sync::oneshot::channel();
+            let producer = spawn_blocking(move || {
+                for _ in 0..16 {
+                    sender.send(&[42]).unwrap();
+                }
+                started.send(()).unwrap();
+                if error {
+                    sender.rust_error(io::Error::other("NAR failed")).is_err()
+                } else {
+                    sender.eof().is_err()
+                }
+            });
+
+            ready.await.unwrap();
+            sleep(Duration::from_millis(100)).await;
+            let blocked = !producer.is_finished();
+            let queued = stream.receiver.len();
+            drop(stream);
+            let failed = timeout(Duration::from_secs(2), producer)
+                .await
+                .unwrap()
+                .unwrap();
+
+            assert_eq!(queued, 16);
+            assert!(blocked, "terminal message did not block");
+            assert!(failed);
+        }
+    }
+
+    #[tokio::test]
+    async fn test_error_follows_data() {
+        let (mut stream, mut sender) = AsyncWriteAdapter::new();
+        let producer = spawn_blocking(move || {
+            for i in 0..32 {
+                sender.send(&[i]).unwrap();
+            }
+            sender.rust_error(io::Error::other("NAR failed")).unwrap();
+        });
+
+        for i in 0..32 {
+            assert_eq!(stream.next().await.unwrap().unwrap(), [i]);
+        }
+        match stream.next().await.unwrap().unwrap_err() {
+            AtticError::CxxError { exception } => assert_eq!(exception, "NAR failed"),
+            error => panic!("unexpected error: {error}"),
+        }
+        producer.await.unwrap();
+        assert!(!stream.eof);
+    }
+
+    #[tokio::test]
+    async fn test_missing_eof_is_an_error() {
+        let (mut stream, sender) = AsyncWriteAdapter::new();
+        drop(sender);
+        assert!(stream.next().await.unwrap().is_err());
+        assert!(!stream.eof);
+    }
+}
