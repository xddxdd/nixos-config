+# Projects whose project details and build status are restricted to
+# authenticated users. Any logged-in user may view them; anonymous users may not.
+my @protectedProjects = ("lantian-private");
+
+sub isProtectedProject {
+    my ($projectName) = @_;
+    return 0 unless defined $projectName;
+    foreach my $p (@protectedProjects) { return 1 if $projectName eq $p; }
+    return 0;
+}
+
+sub requireProjectView {
+    my ($c, $projectName) = @_;
+    requireUser($c) if isProtectedProject($projectName);
+}
+
 
