+ */
+
+package translate
+
+import (
+	utls "github.com/refraction-networking/utls"
+)
+
+// urlSessionHello is the TLS ClientHello sent to DeepL — a byte-exact
+// replica of the real DeepL iOS app's hello, captured from an iOS 27
+// beta device connecting to ita-free.www.deepl.com (ClientHello is
+// plaintext in the TLS handshake, so no decryption was needed).
+//
+// Capture reference (dump.pcap, frame 35, SNI ita-free.www.deepl.com):
+//   JA3 ecdf4f49dd59effc439639da29186671
+//   JA4 t13d2013h1_a09f3c656075_7f0f34a4126d
+// Notable Apple-stack traits it preserves:
+//   - TLS 1.3 suites ordered 1302/1303/1301 (not 1301/1302/1303)
+//   - DRAFT ChaCha20 codepoints 0xcca9/0xcca8 (Apple never adopted the
+//     final 0xccac/0xccaa; Safari-browser captures differ here)
+//   - X25519MLKEM768 post-quantum group + 1216-byte key share (new in
+//     the iOS 27 stack — absent from Safari 26 captures)
+//   - 3DES fallback suites still present (0xc008/0xc012/0x000a)
+//   - NO session_ticket and NO padding extension (Safari sends both;
+//     URLSession sends neither)
+//   - duplicated rsa_pss_rsae_sha384 sigalg, SHA-1 fallback sigalgs
+//   - ALPN: http/1.1 ONLY — the app talks plain HTTP/1.1 to ita-free,
+//     so no HTTP/2 fingerprint is involved at all
+//
+// Why this matters — DeepL's oneshot WAF fingerprint-gates by HOST:
+//   - oneshot-free.www.deepl.com is the Chrome extension's host. There,
+//     any Apple-family hello paired with an iOS-app story is checked
+//     against a denylist of published impersonation templates (utls
+//     HelloIOS_Auto/HelloIOS_11..14, curl-impersonate safari*_ios, …).
+//     The old SetTLSFingerprintIOS() (utls HelloIOS_14, an iOS 14-era
+//     template) was the HTTP 429 breakage; even this byte-exact app
+//     hello 429s there, because the real app never uses that host.
+//   - ita-free.www.deepl.com is the app's own host (ItaClient). There,
+//     the byte-exact app hello passes cleanly (verified 9/9 incl. the
+//     x-app-* headers and iOS app_information).
+// Hence translate.go targets ita-free for the free tier.
+//
+// Do NOT "simplify" this spec toward a Safari/browser capture or a utls
+// bundled template: both the field values and their order are load-bearing
+// parts of the app's real fingerprint.
+func urlSessionHello() utls.ClientHelloSpec {
+	return utls.ClientHelloSpec{
+		// 21 suites incl. GREASE, exact capture order.
+		CipherSuites: []uint16{
+			utls.GREASE_PLACEHOLDER,
+			utls.TLS_AES_256_GCM_SHA384,
+			utls.TLS_CHACHA20_POLY1305_SHA256,
+			utls.TLS_AES_128_GCM_SHA256,
+			utls.TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,
+			utls.TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,
+			0xcca9, // TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256, draft codepoint (Apple)
+			utls.TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,
+			utls.TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,
+			0xcca8, // TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256, draft codepoint (Apple)
+			utls.TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA,
+			utls.TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA,
+			utls.TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA,
+			utls.TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA,
+			utls.TLS_RSA_WITH_AES_256_GCM_SHA384,
+			utls.TLS_RSA_WITH_AES_128_GCM_SHA256,
+			utls.TLS_RSA_WITH_AES_256_CBC_SHA,
+			utls.TLS_RSA_WITH_AES_128_CBC_SHA,
+			0xc008, // TLS_ECDHE_ECDSA_WITH_3DES_EDE_CBC_SHA
+			utls.TLS_ECDHE_RSA_WITH_3DES_EDE_CBC_SHA,
+			utls.TLS_RSA_WITH_3DES_EDE_CBC_SHA,
+		},
+		CompressionMethods: []byte{0x00},
+		// Extension set and order exactly as captured.
+		Extensions: []utls.TLSExtension{
+			&utls.UtlsGREASEExtension{},
+			&utls.SNIExtension{},
+			&utls.ExtendedMasterSecretExtension{},
+			&utls.RenegotiationInfoExtension{Renegotiation: utls.RenegotiateOnceAsClient},
+			&utls.SupportedCurvesExtension{Curves: []utls.CurveID{
+				utls.CurveID(utls.GREASE_PLACEHOLDER),
+				utls.X25519MLKEM768,
+				utls.X25519,
+				utls.CurveP256,
+				utls.CurveP384,
+				utls.CurveP521,
+			}},
+			&utls.SupportedPointsExtension{SupportedPoints: []byte{0x00}},
+			// The app negotiates plain HTTP/1.1 with ita-free — do not
+			// add "h2" here; over ita-free the app never offers it.
+			&utls.ALPNExtension{AlpnProtocols: []string{"http/1.1"}},
+			&utls.StatusRequestExtension{},
+			&utls.SignatureAlgorithmsExtension{SupportedSignatureAlgorithms: []utls.SignatureScheme{
+				utls.ECDSAWithP256AndSHA256,
+				utls.PSSWithSHA256,
+				utls.PKCS1WithSHA256,
+				utls.ECDSAWithP384AndSHA384,
+				utls.PSSWithSHA384,
+				utls.PSSWithSHA384, // Apple sends rsa_pss_rsae_sha384 twice
+				utls.PKCS1WithSHA384,
+				utls.PSSWithSHA512,
+				utls.PKCS1WithSHA512,
+				utls.PKCS1WithSHA1,
+			}},
+			&utls.SCTExtension{},
+			// MLKEM entry with empty Data: utls generates the fresh
+			// 1216-byte X25519MLKEM768 share per handshake.
+			&utls.KeyShareExtension{KeyShares: []utls.KeyShare{
+				{Group: utls.CurveID(utls.GREASE_PLACEHOLDER), Data: []byte{0}},
+				{Group: utls.X25519MLKEM768},
+				{Group: utls.X25519},
+			}},
+			&utls.PSKKeyExchangeModesExtension{Modes: []uint8{utls.PskModeDHE}},
+			&utls.SupportedVersionsExtension{Versions: []uint16{
+				utls.GREASE_PLACEHOLDER,
+				utls.VersionTLS13,
+				utls.VersionTLS12,
+			}},
+			&utls.UtlsCompressCertExtension{Algorithms: []utls.CertCompressionAlgo{utls.CertCompressionZlib}},
+			&utls.UtlsGREASEExtension{},
+			// No SessionTicketExtension, no UtlsPaddingExtension —
+			// the captured app hello contains neither.
+		},
+	}
+}
