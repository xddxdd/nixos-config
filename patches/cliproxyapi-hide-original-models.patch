+// aliasedOriginalIDsLocked collects canonical model IDs that are currently
+// listed under an alias or provider-prefixed ID. Alias and prefix clones keep
+// MetadataModelID pointing at the original model ID while listing a different
+// ID themselves, so when such a clone is listed the original bare entry is
+// hidden from model listings to avoid duplicate-looking IDs (routing still
+// resolves the original ID, because only the listing is filtered).
+func (r *ModelRegistry) aliasedOriginalIDsLocked(now time.Time) map[string]struct{} {
+	originals := make(map[string]struct{}, len(r.models))
+	for _, registration := range r.models {
+		if registration == nil || registration.Info == nil {
+			continue
+		}
+		available, _ := modelRegistrationAvailability(registration, now)
+		if !available {
+			continue
+		}
+		listedID := strings.TrimSpace(registration.Info.ID)
+		canonicalID := strings.TrimSpace(registration.Info.MetadataModelID)
+		if listedID == "" || canonicalID == "" || strings.EqualFold(listedID, canonicalID) {
+			continue
+		}
+		originals[strings.ToLower(canonicalID)] = struct{}{}
+	}
+	return originals
+}
+
+// modelInfoListed reports whether a registered model info should appear in
+// model listings: entries whose canonical form is also listed under an
+// alias/prefixed ID are hidden.
+func modelInfoListed(info *ModelInfo, aliasedOriginals map[string]struct{}) bool {
+	if info == nil {
+		return false
+	}
+	infoID := strings.TrimSpace(info.ID)
+	if infoID == "" {
+		return false
+	}
+	_, isAliasedOriginal := aliasedOriginals[strings.ToLower(infoID)]
+	return !isAliasedOriginal
+}
