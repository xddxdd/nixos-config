@@ -1,5 +1,32 @@
 package main
 
+import "encoding/json"
+
+// Strings unmarshals a claim that may be either a plain JSON string
+// or an array of strings into a []string.
+type Strings []string
+
+func (s *Strings) UnmarshalJSON(data []byte) error {
+	if string(data) == "null" {
+		*s = nil
+		return nil
+	}
+
+	var single string
+	if err := json.Unmarshal(data, &single); err == nil {
+		*s = Strings{single}
+		return nil
+	}
+
+	var multi []string
+	if err := json.Unmarshal(data, &multi); err != nil {
+		return err
+	}
+
+	*s = multi
+	return nil
+}
+
